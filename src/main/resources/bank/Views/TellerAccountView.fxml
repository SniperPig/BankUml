<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="900.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="bank.Controllers.TellerAccountViewController"
            style="-fx-background-color: white;">
    <children>
        <VBox alignment="TOP_CENTER" spacing="25.0"
              AnchorPane.leftAnchor="40.0"
              AnchorPane.rightAnchor="40.0"
              AnchorPane.topAnchor="40.0"
              AnchorPane.bottomAnchor="40.0">
            <children>
                <Label fx:id="accountHeading"
                       text="{name}'s Account"
                       style="-fx-font-size: 42px; -fx-font-weight: bold;"/>
                <Hyperlink text="Back to Home"
                           onAction="#handleBackToDashboard"
                           style="-fx-font-size: 18px; -fx-text-fill: #6c4fff;"/>
                <HBox spacing="20.0" alignment="CENTER">
                    <children>
                        <Button text="Withdraw"
                                onAction="#handleWithdraw"
                                prefWidth="150.0"
                                prefHeight="50.0"
                                style="-fx-background-color: #7563F6; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 14px;"/>
                        <Button text="Deposit"
                                onAction="#handleDeposit"
                                prefWidth="150.0"
                                prefHeight="50.0"
                                style="-fx-background-color: #7563F6; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 14px;"/>
                        <Button text="Transfer"
                                onAction="#handleTransfer"
                                prefWidth="150.0"
                                prefHeight="50.0"
                                style="-fx-background-color: #7563F6; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 14px;"/>
                    </children>
                </HBox>
                <VBox spacing="10.0" prefWidth="800.0">
                    <children>
                        <Label text="Accounts"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <TableView fx:id="accountsTable"
                                   prefHeight="200.0">
                            <columns>
                                <TableColumn fx:id="accountTypeColumn" text="Type" prefWidth="200.0"/>
                                <TableColumn fx:id="accountNumberColumn" text="Account Number" prefWidth="260.0"/>
                                <TableColumn fx:id="accountBalanceColumn" text="Current Balance" prefWidth="260.0"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <VBox spacing="10.0" prefWidth="800.0">
                    <children>
                        <Label text="Recent Transactions"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <TableView fx:id="transactionsTable"
                                   prefHeight="220.0">
                            <columns>
                                <TableColumn fx:id="transactionDateColumn" text="Date" prefWidth="140.0"/>
                                <TableColumn fx:id="transactionDescriptionColumn" text="Description" prefWidth="100.0"/>
                                <TableColumn fx:id="transactionAmountColumn" text="Amount" prefWidth="140.0"/>
                                <TableColumn fx:id="transactionStatusColumn" text="Status" prefWidth="140.0"/>
                                <TableColumn fx:id="transactionBalanceColumn" text="Balance After Transaction" prefWidth="160.0"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets top="10.0" bottom="10.0"/>
            </padding>
        </VBox>
        <Hyperlink text="Logout"
                   onAction="#handleLogout"
                   style="-fx-font-size: 16px; -fx-text-fill: #6c4fff;"
                   AnchorPane.bottomAnchor="20.0"
                   AnchorPane.rightAnchor="30.0"/>
    </children>
</AnchorPane>
