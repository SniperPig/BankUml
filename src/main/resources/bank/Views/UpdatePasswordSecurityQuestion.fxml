<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="450.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="bank.Controllers.UpdatePasswordSecurityQuestionController"
            style="-fx-background-color: white;">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="50.0"
              AnchorPane.bottomAnchor="60.0">
            <children>
                <Label text="Update Password"
                       style="-fx-font-size: 40px; -fx-font-weight: bold;"/>
                <Hyperlink text="Back to Account Page"
                           focusTraversable="false"
                           onAction="#handleBackToAccount"
                           style="-fx-font-size: 16px; -fx-text-fill: #6c4fff;"/>
                <VBox spacing="12.0" maxWidth="320.0">
                    <children>
                        <Label text="In order to update your password, please first answer the following security question:"
                               wrapText="true"
                               style="-fx-font-size: 16px;"/>
                        <Label text="What was the name of your first cat?"
                               style="-fx-font-size: 16px; -fx-font-style: italic;"/>
                        <TextField fx:id="answerField"
                                   promptText="Enter answer here"
                                   prefHeight="40.0"
                                   style="-fx-font-size: 15px;"/>
                    </children>
                </VBox>
                <Button text="Confirm"
                        onAction="#handleConfirmAnswer"
                        prefWidth="200.0"
                        prefHeight="50.0"
                        style="-fx-background-color: #7563F6; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 25px;"/>
            </children>
            <padding>
                <Insets left="25.0" right="25.0"/>
            </padding>
        </VBox>
        <Hyperlink text="Logout"
                   onAction="#handleLogout"
                   style="-fx-font-size: 15px; -fx-text-fill: #6c4fff;"
                   AnchorPane.bottomAnchor="20.0"
                   AnchorPane.rightAnchor="20.0"/>
    </children>
</AnchorPane>
