<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="bank.Controllers.ManageUserRoleController"
            prefWidth="700.0" prefHeight="500.0"
            style="-fx-background-color: white;">
    <children>
        <VBox spacing="20.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.bottomAnchor="20.0">

            <!-- Header -->
            <HBox spacing="10.0">
                <Label text="Manage User Role"
                       style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Back to Admin Dashboard"
                           onAction="#handleBackToAdmin"
                           style="-fx-font-size: 18px; -fx-text-fill: #6c4fff;"/>
            </HBox>

            <!-- User info (read-only) -->
            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30.0"/>
                    <ColumnConstraints percentWidth="70.0"/>
                </columnConstraints>

                <Label text="User Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="userTypeLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="nameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="emailLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Current Role:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="currentRoleLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Current Branch:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="currentBranchLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Editable fields -->
            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30.0"/>
                    <ColumnConstraints percentWidth="70.0"/>
                </columnConstraints>

                <Label text="New Role:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="roleCombo"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="New Branch:"
                       fx:id="branchLabel"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="branchCombo"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="New Secondary Password:"
                       fx:id="newSecPwdLabel"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <PasswordField fx:id="newSecondaryPasswordField"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Admin Secondary Password:"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <PasswordField fx:id="adminSecondaryPasswordField"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="errorLabel"
                   style="-fx-text-fill: red;"/>

            <!-- Actions -->
            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button text="Cancel"
                        onAction="#handleCancel"/>
                <Button text="Save Changes"
                        onAction="#handleSaveChanges"/>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
