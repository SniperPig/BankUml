<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="450.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="bank.Controllers.TransferController"
            style="-fx-background-color: white;">

    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="50.0"
              AnchorPane.bottomAnchor="40.0"
              prefWidth="400.0">

            <children>
                <!-- Title -->
                <Label text="Transfer Money"
                       style="-fx-font-size: 30px; -fx-font-weight: bold;"/>

                <!-- Back link -->
                <Hyperlink fx:id="backLink"
                           text="Back"
                           focusTraversable="false"
                           style="-fx-font-size: 14px; -fx-text-fill: #6c4fff;"/>

                <!-- Notification label -->
                <Label fx:id="notificationLabel"
                       text=""
                       style="-fx-font-size: 14px; -fx-text-fill: red;"/>

                <!-- Amount input -->
                <VBox spacing="6.0" maxWidth="300.0">
                    <children>
                        <Label text="Amount:" style="-fx-font-size: 16px;"/>
                        <TextField fx:id="amountField"
                                   promptText="0.00"
                                   prefHeight="40.0"
                                   style="-fx-font-size: 15px;"/>
                    </children>
                </VBox>

                <!-- Destination account input -->
                <VBox spacing="6.0" maxWidth="300.0">
                    <children>
                        <Label text="To Account #:" style="-fx-font-size: 16px;"/>
                        <TextField fx:id="destinationAccountField"
                                   promptText="Enter account number"
                                   prefHeight="40.0"
                                   style="-fx-font-size: 15px;"/>
                    </children>
                </VBox>

                <Region prefHeight="20.0"/>

                <!-- Confirm button -->
                <Button fx:id="confirmButton"
                        text="Transfer"
                        prefWidth="230.0"
                        prefHeight="50.0"
                        style="-fx-background-color: #7563F6; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 25px;"/>
            </children>

            <padding>
                <Insets left="25.0" right="25.0"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>
