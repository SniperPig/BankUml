<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Connect to CustomerDashboardController-->
<AnchorPane prefHeight="900.0" prefWidth="900.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="bank.Controllers.CustomerDashboardController"
            stylesheets="@../css/customerDashboard.css">
    <children>
        <!-- Main container -->
        <VBox alignment="TOP_CENTER" spacing="18.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              AnchorPane.topAnchor="30.0"
              AnchorPane.bottomAnchor="70.0">
            <children>
                <!-- Title-->
                <Label fx:id="welcomeLabel"
                       text="Welcome, {name}"
                       styleClass="heading"/>
                <!-- Update password hyperlink-->
                <Hyperlink text="Update Password"
                           onAction="#handleUpdatePassword"
                           focusTraversable="false"
                           styleClass="update-password-link"/>
                <HBox spacing="20.0" alignment="CENTER">
                <!-- 3 buttons for transactions -->
                    <children>
                        <Button text="Withdraw"
                                onAction="#handleWithdraw"
                                styleClass="action-button"/>
                        <Button text="Deposit"
                                onAction="#handleDeposit"
                                styleClass="action-button"/>
                        <Button text="Transfer"
                                onAction="#handleTransfer"
                                styleClass="action-button"/>
                    </children>
                </HBox>
                <Region prefHeight="20.0"/>
                <VBox spacing="12.0" maxWidth="820.0" styleClass="section-block">
                    <children>
                    <!-- First table to show list of accounts-->
                        <Label text="Accounts"
                               styleClass="section-title"/>
                        <TableView fx:id="accountsTable"
                                   prefHeight="160.0"
                                   styleClass="styled-table">
                            <columns>
                                <TableColumn fx:id="accountTypeColumn" text="Type" prefWidth="160.0"/>
                                <TableColumn fx:id="accountNumberColumn" text="Account Number" prefWidth="240.0"/>
                                <TableColumn fx:id="accountBalanceColumn" text="Current Balance" prefWidth="200.0"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <Region prefHeight="20.0"/>
                <VBox spacing="12.0" maxWidth="820.0" styleClass="section-block" VBox.vgrow="ALWAYS">
                    <children>
                    <!-- Second table to show list of recent transactions for the account-->
                        <Label text="Recent Transactions"
                               styleClass="section-title"/>
                        <TableView fx:id="transactionsTable"
                                   prefHeight="240.0"
                                   styleClass="styled-table"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="transactionDateColumn" text="Date" prefWidth="140.0"/>
                                <TableColumn fx:id="transactionDescriptionColumn" text="Description" prefWidth="100.0"/>
                                <TableColumn fx:id="transactionAmountColumn" text="Amount" prefWidth="140.0"/>
                                <TableColumn fx:id="transactionStatusColumn" text="Status" prefWidth="140.0"/>
                                <TableColumn fx:id="transactionBalanceColumn" text="Balance After Transaction" prefWidth="160.0"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets top="10.0" bottom="10.0"/>
            </padding>
        </VBox>
        <!-- Logout hyperlink-->
        <Hyperlink text="Logout"
                   onAction="#handleLogout"
                   styleClass="logout-link"
                   AnchorPane.bottomAnchor="24.0"
                   AnchorPane.rightAnchor="32.0"/>
    </children>
</AnchorPane>