<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="450.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="bank.Controllers.ResetPasswordFormController"
            style="-fx-background-color: white;">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="50.0"
              AnchorPane.bottomAnchor="40.0"
              prefWidth="400.0">
            <children>
                <Label text="Reset Password"
                       style="-fx-font-size: 40px; -fx-font-weight: bold;"/>
                <Hyperlink text="Back to Login"
                           focusTraversable="false"
                           onAction="#handleBackToLogin"
                           style="-fx-font-size: 16px; -fx-text-fill: #6c4fff;"/>
                <VBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="340.0">
                    <children>
                        <Label text="In your new password, please include at least:"
                               style="-fx-font-size: 16px;"/>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="• Eight characters" style="-fx-font-size: 15px;"/>
                                <Label text="• One symbol" style="-fx-font-size: 15px;"/>
                                <Label text="• One capital letter" style="-fx-font-size: 15px;"/>
                                <Label text="• One lowercase letter" style="-fx-font-size: 15px;"/>
                                <Label text="• One number" style="-fx-font-size: 15px;"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
                <VBox spacing="15.0" maxWidth="310.0">
                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="Enter password:" style="-fx-font-size: 16px;"/>
                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                    <children>
                                        <StackPane HBox.hgrow="ALWAYS">
                                            <children>
                                                <PasswordField fx:id="newPasswordField"
                                                               promptText="Enter password here"
                                                               prefHeight="40.0"
                                                               style="-fx-font-size: 15px;"/>
                                                <TextField fx:id="newPasswordVisibleField"
                                                           promptText="Enter password here"
                                                           prefHeight="40.0"
                                                           style="-fx-font-size: 15px;"/>
                                            </children>
                                        </StackPane>
                                        <ToggleButton fx:id="newPasswordToggle"
                                                      onAction="#toggleNewPasswordVisibility"
                                                      focusTraversable="false"
                                                      style="-fx-background-color: transparent; -fx-padding: 6 10;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="Confirm password:" style="-fx-font-size: 16px;"/>
                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                    <children>
                                        <StackPane HBox.hgrow="ALWAYS">
                                            <children>
                                                <PasswordField fx:id="confirmPasswordField"
                                                               promptText="Confirm password here"
                                                               prefHeight="40.0"
                                                               style="-fx-font-size: 15px;"/>
                                                <TextField fx:id="confirmPasswordVisibleField"
                                                           promptText="Confirm password here"
                                                           prefHeight="40.0"
                                                           style="-fx-font-size: 15px;"/>
                                            </children>
                                        </StackPane>
                                        <ToggleButton fx:id="confirmPasswordToggle"
                                                      onAction="#toggleConfirmPasswordVisibility"
                                                      focusTraversable="false"
                                                      style="-fx-background-color: transparent; -fx-padding: 6 10;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
                <Region prefHeight="20.0"/>
                <Button text="Reset Password"
                        onAction="#handleResetPassword"
                        prefWidth="230.0"
                        prefHeight="50.0"
                        style="-fx-background-color: #7563F6; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 25px;"/>
            </children>
            <padding>
                <Insets left="25.0" right="25.0"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>
