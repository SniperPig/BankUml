<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="900.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="bank.Controllers.TellerDashboardController"
            style="-fx-background-color: white;">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              AnchorPane.topAnchor="40.0"
              AnchorPane.bottomAnchor="40.0">
            <children>
                <Label fx:id="welcomeLabel"
                       text="Welcome, {name}"
                       style="-fx-font-size: 42px; -fx-font-weight: bold;"/>
                <HBox spacing="40.0" alignment="CENTER">
                    <children>
                        <Hyperlink text="Create New Account"
                                   onAction="#handleCreateAccount"
                                   focusTraversable="false"
                                   style="-fx-font-size: 18px; -fx-text-fill: #6c4fff;"/>
                        <Hyperlink text="Update Password"
                                   onAction="#handleUpdatePassword"
                                   focusTraversable="false"
                                   style="-fx-font-size: 18px; -fx-text-fill: #6c4fff;"/>
                    </children>
                </HBox>
                <VBox spacing="8.0" maxWidth="600.0">
                    <children>
                        <Label text="Search:"
                               style="-fx-font-size: 18px;"/>
                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="searchField"
                                           promptText="Enter keyword"
                                           prefWidth="280.0"
                                           onAction="#handleSearch"
                                           style="-fx-font-size: 16px;"/>
                                <Label text="in"
                                       style="-fx-font-size: 16px;"/>
                                <ComboBox fx:id="searchCategoryBox"
                                          prefWidth="180.0"
                                          style="-fx-font-size: 16px;"/>
                                <Button text="Search"
                                        onAction="#handleSearch"
                                        style="-fx-background-color: #7563F6; -fx-text-fill: white; -fx-background-radius: 8px; -fx-font-size: 15px;"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox spacing="10.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="Search Results"
                               alignment="CENTER_LEFT"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <TableView fx:id="customerTable"
                                   prefHeight="400.0"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0"/>
                                <TableColumn fx:id="nameColumn" text="Name" prefWidth="150.0"/>
                                <TableColumn fx:id="emailColumn" text="Email" prefWidth="200.0"/>
                                <TableColumn fx:id="phoneColumn" text="Phone Number" prefWidth="150.0"/>
                                <TableColumn fx:id="dobColumn" text="Date of Birth" prefWidth="120.0"/>
                                <TableColumn fx:id="govIdColumn" text="Government ID" prefWidth="150.0"/>
                                <TableColumn fx:id="addressColumn" text="Address" prefWidth="200.0"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <Region prefHeight="20.0"/>
                <Button text="Open Account"
                        onAction="#handleOpenAccount"
                        prefWidth="240.0"
                        prefHeight="55.0"
                        style="-fx-background-color: #7563F6; -fx-text-fill: white; -fx-font-size: 20px; -fx-background-radius: 25px;"/>
            </children>
            <padding>
                <Insets top="10.0" bottom="10.0"/>
            </padding>
        </VBox>
        <Hyperlink text="Logout"
                   onAction="#handleLogout"
                   style="-fx-font-size: 16px; -fx-text-fill: #6c4fff;"
                   AnchorPane.bottomAnchor="20.0"
                   AnchorPane.rightAnchor="30.0"/>
    </children>
</AnchorPane>
