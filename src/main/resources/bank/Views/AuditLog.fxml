<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="bank.Controllers.AuditLogController"
            prefWidth="950.0" prefHeight="700.0"
            style="-fx-background-color: white;">
    <children>
        <VBox spacing="20.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.bottomAnchor="20.0">

            <!-- Header -->
            <HBox spacing="10.0">
                <Label text="Audit Log"
                       style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Back to Admin Dashboard"
                           onAction="#handleBackToAdmin"
                           style="-fx-font-size: 18px; -fx-text-fill: #6c4fff;"/>
                <Hyperlink text="Logout"
                           onAction="#handleLogout"
                           style="-fx-font-size: 18px; -fx-text-fill: #6c4fff;"/>
            </HBox>

            <!-- Filters -->
            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="15.0"/>
                    <ColumnConstraints percentWidth="20.0"/>
                    <ColumnConstraints percentWidth="15.0"/>
                    <ColumnConstraints percentWidth="20.0"/>
                    <ColumnConstraints percentWidth="15.0"/>
                    <ColumnConstraints percentWidth="15.0"/>
                </columnConstraints>

                <Label text="From:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <DatePicker fx:id="fromDatePicker"
                            GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="To:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <DatePicker fx:id="toDatePicker"
                            GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Branch:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="branchCombo"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Actor type:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <ComboBox fx:id="actorTypeCombo"
                          GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Actor ID:" GridPane.rowIndex="1" GridPane.columnIndex="4"/>
                <TextField fx:id="actorIdField"
                           promptText="Optional"
                           GridPane.rowIndex="1" GridPane.columnIndex="5"/>
            </GridPane>

            <HBox spacing="10.0">
                <Button text="Apply Filters"
                        onAction="#handleApplyFilters"/>
                <Button text="Clear"
                        onAction="#handleClearFilters"/>
                <Label fx:id="errorLabel"
                       style="-fx-text-fill: red;"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="auditTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 14px; -fx-text-fill: #6c4fff;">
                <columns>
                    <TableColumn fx:id="timeColumn" text="Time" prefWidth="150.0"/>
                    <TableColumn fx:id="branchColumn" text="Branch ID" prefWidth="80.0"/>
                    <TableColumn fx:id="actorTypeColumn" text="Actor Type" prefWidth="90.0"/>
                    <TableColumn fx:id="actorIdColumn" text="Actor ID" prefWidth="80.0"/>
                    <TableColumn fx:id="actionColumn" text="Action" prefWidth="120.0"/>
                    <TableColumn fx:id="targetTypeColumn" text="Target Type" prefWidth="100.0"/>
                    <TableColumn fx:id="targetIdColumn" text="Target ID" prefWidth="80.0"/>
                    <TableColumn fx:id="detailsColumn" text="Details" prefWidth="250.0"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
